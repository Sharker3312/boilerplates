# Copy to .env with real values. Never commit .env (this repo is public).
#
# SMTP2GO account used to deliver Gatus email alerts
# (alerting.email in config/config.yaml).
SMTP2GO_USER=
SMTP2GO_PASSWORD=

# API key for the ProvidersMonitorLambda Function URL checked by the
# "Cargo Expreso" and "DigiFact" endpoints (x-api-key header).
PROVIDERS_API_KEY=
